apiVersion: kafka.strimzi.io/v1beta2
kind: Kafka
metadata:
  name: studymate-kafka
  namespace: kafka
spec:
  kafka:
    version: {{ kafka_version }}
    replicas: {{ kafka_replicas }}
    listeners:
      - name: plain
        port: 9092
        type: internal
        tls: false
      - name: tls
        port: 9093
        type: internal
        tls: true
    config:
      offsets.topic.replication.factor: {{ kafka_replicas }}
      transaction.state.log.replication.factor: {{ kafka_replicas }}
      transaction.state.log.min.isr: 1
      default.replication.factor: {{ kafka_replicas }}
      min.insync.replicas: 1
      inter.broker.protocol.version: "3.5"
    storage:
      type: jbod
      volumes:
        - id: 0
          type: persistent-claim
          size: {{ kafka_storage_size }}
          deleteClaim: false
  zookeeper:
    replicas: {{ zookeeper_replicas }}
    storage:
      type: persistent-claim
      size: {{ zookeeper_storage_size }}
      deleteClaim: false
  entityOperator:
    topicOperator: {}
    userOperator: {}